rules_version = '2';

// ============================================================
// Firestore 보안 규칙 (v2 — Authentication 없이 웹앱에서 직접 등록/평점 남기기)
// ============================================================
// 이 프로젝트는 Firebase Authentication을 쓰지 않는 개인/소규모 공유용 MVP다.
// 그래서 "누구나 restaurants를 추가할 수 있고, 누구나 평점을 남길 수 있음"으로
// 열어두되, 아래 두 가지로 피해 범위를 최소화한다.
//   1) create(신규 등록)는 필수 필드/타입이 맞는 문서만 허용한다.
//   2) update(평점 남기기)는 my.ratingSum / my.ratingCount / updatedAt
//      "필드만" 바꾸는 요청만 허용한다 (그것도 정확히 count +1, 1~5점 범위).
//      즉 다른 사람이 이미 등록한 맛집의 이름/좌표/상태 등은 이 규칙으로는
//      절대 고칠 수 없다.
//
// ⚠️ 이것은 "진짜 보안"이 아니라 최소한의 오남용 방지 장치다.
// Firebase Web SDK config는 원래 공개되는 값이라, 이 앱 주소를 아는 사람은
// 누구나 새 맛집을 추가하거나 평점을 남길 수 있다. 가족/친구 등 소수와만
// 공유한다면 괜찮지만, 불특정 다수에게 공개할 계획이라면 아래 맨 아래
// 주석에 있는 "로그인 필요" 버전으로 바꾸는 것을 권장한다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /restaurants/{restaurantId} {
      allow read: if true;

      allow create: if isValidNewRestaurant(request.resource.data);

      allow update: if isRatingOnlyUpdate(request.resource.data, resource.data);

      // 삭제/이름·좌표·상태 수정은 앱에서 지원하지 않음 (Firestore 콘솔에서 직접 처리)
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidNewRestaurant(data) {
  return data.keys().hasAll(['name', 'country', 'latitude', 'longitude', 'categories', 'status', 'my'])
    && data.name is string && data.name.size() > 0 && data.name.size() < 200
    && data.country in ['KR', 'JP']
    && data.latitude is number && data.latitude > -90 && data.latitude < 90
    && data.longitude is number && data.longitude > -180 && data.longitude < 180
    && data.categories is list && data.categories.size() > 0
    && data.status in ['want', 'visited', 'avoid']
    && data.my.ratingSum == 0 && data.my.ratingCount == 0; // 새 문서는 항상 평점 0에서 시작
}

function isRatingOnlyUpdate(newData, oldData) {
  return newData.diff(oldData).affectedKeys().hasOnly(['my', 'updatedAt'])
    && newData.my.ratingCount == oldData.my.ratingCount + 1
    && newData.my.ratingSum >= oldData.my.ratingSum + 1
    && newData.my.ratingSum <= oldData.my.ratingSum + 5;
}

// ------------------------------------------------------------
// 참고: 나중에 Authentication을 도입하면 아래처럼 "로그인 필요"로 바꿀 수 있다.
// (본문 규칙에서 allow create/update 줄만 아래 두 줄로 교체)
//
//   allow create: if request.auth != null && isValidNewRestaurant(request.resource.data);
//   allow update: if request.auth != null && isRatingOnlyUpdate(request.resource.data, resource.data);
// ------------------------------------------------------------
